    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "iovalkey": "0.4.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.17",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
